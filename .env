# ---------------------------------------------------------------------------
# Faculty Evaluation System (FES) — server configuration
# Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

NODE_ENV=development
PORT=4000

# Runtime connection (least-privilege role, no UPDATE/DELETE on audit tables).
# docker-compose publishes PostgreSQL on host port 5433 to avoid clashing with a local install.
DATABASE_URL=postgres://fes_app:fes_app_dev_password@localhost:5433/fes
# Schema owner used only by `npm run db:migrate` and `npm run db:seed`.
MIGRATION_DATABASE_URL=postgres://fes_owner:fes_owner_dev_password@localhost:5433/fes
# Role that receives runtime grants during migrations.
DB_APP_ROLE=fes_app

# Public URL of the web app (used in password-reset / invite links and Origin checks).
APP_BASE_URL=http://localhost:5173

# Sessions — idle timeout must be between 15 and 30 minutes.
SESSION_IDLE_MINUTES=15
SESSION_ABSOLUTE_HOURS=12
# Keep `true` in every environment; browsers accept Secure cookies on http://localhost.
COOKIE_SECURE=true
# Set to the number of reverse proxies in front of the API (e.g. 1 behind Nginx).
TRUST_PROXY=0

# Account protection
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Password-reset token lifetime (15–30 minutes).
PASSWORD_RESET_TTL_MINUTES=30
INVITE_TTL_HOURS=72

# Transactional email (Resend). Leave RESEND_API_KEY empty in development to
# print emails to the server console instead of sending them.
RESEND_API_KEY=
MAIL_FROM="FES Notifications <no-reply@example.edu.ph>"

# Development seed only (`npm run db:seed`). Refused when NODE_ENV=production.
SEED_DEMO_PASSWORD=Fes-Demo-2026!
