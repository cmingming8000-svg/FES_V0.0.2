{
  "name": "faculty-evaluation-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:server": "tsx watch --include=.env --env-file-if-exists=.env server/src/index.ts",
    "build": "vite build",
    "start": "node --env-file-if-exists=.env --import tsx server/src/index.ts",
    "db:up": "docker compose up -d db",
    "db:migrate": "tsx --env-file-if-exists=.env server/src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env server/src/db/seed.ts",
    "test:smoke": "tsx --env-file-if-exists=.env server/scripts/smoke-test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@node-rs/argon2": "^2.0.2",
    "@supabase/supabase-js": "^2.98.0",
    "canvas-confetti": "^1.9.3",
    "cookie-parser": "^1.4.7",
    "date-fns": "^2.30.0",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^7.5.0",
    "framer-motion": "^11.16.1",
    "helmet": "^8.1.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.294.0",
    "pg": "^8.16.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "tsx": "^4.20.0",
    "uuid": "^9.0.1",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/canvas-confetti": "^1.6.4",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.4",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/uuid": "^9.0.7",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.2.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.7.0",
    "vite": "^6.3.5"
  }
}
